# Artificial Neural Network using Backpropagation
# Dataset: XOR Problem

from sklearn.neural_network import MLPClassifier
import numpy as np

# Training Data (XOR)
X = np.array([
    [0,0],
    [0,1],
    [1,0],
    [1,1]
])

# Target Output
y = np.array([0,1,1,0])

# Create ANN Model
model = MLPClassifier(hidden_layer_sizes=(2,),
                      activation='logistic',
                      solver='lbfgs',
                      max_iter=1000,
                      random_state=1)

# Train the model
model.fit(X, y)

# Predict the outputs
predictions = model.predict(X)

print("Training Data:")
print(X)

print("\nActual Output:")
print(y)

print("\nPredicted Output:")
print(predictions)

# Test a new sample
new_sample = np.array([[1,0]])
prediction = model.predict(new_sample)

print("\nPrediction for New Sample [1,0]:")
print(prediction[0])
